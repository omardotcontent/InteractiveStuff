make wasSneaking = false
make isSneaking = false

make wasOnRedstone = false
make isOnRedstone = false

make progress = 0
make stprogress = 0


task onTick do
    check player.getWorld() == nothing do
        reply nothing
    end

    make isSneaking = player.isSneaking()
    make isOnRedstone = player.getSteppingBlock().getName() == "minecraft:redstone_block"

    check (isp.isHoldingItem("minecraft:piston") || isp.isHoldingItem("minecraft:sticky_piston")) do

        check isOnRedstone && !wasOnRedstone && isSneaking do
            player.playSound("minecraft:block.piston.extend", 0.5, 1)
        end

        check isOnRedstone && isSneaking && !wasSneaking do
            player.playSound("minecraft:block.piston.extend", 0.5, 1)
        end

        check isOnRedstone && !isSneaking && wasSneaking do
            player.playSound("minecraft:block.piston.contract", 0.5, 1)
        end

        check !isOnRedstone && wasOnRedstone && wasSneaking do
            player.playSound("minecraft:block.piston.contract", 0.5, 1)
        end

    end

    make wasSneaking = isSneaking
    make wasOnRedstone = isOnRedstone
end


task onItemUpdate takes itemRendered do

    make vy = player.getVelocityY()
    make fallTarget = 0


    check vy < -0.1 do
        make fallTarget = vy * -100
        check fallTarget > 100 do
            make fallTarget = 100
        end
    end


    check itemRendered.getName() == "minecraft:piston" do
        itemRendered.setItemModel("interactivestuff:piston_base")

        make pistonTop = new ItemModel("minecraft:piston")
        pistonTop.setItemModel("interactivestuff:piston_top")

        make currentTarget = fallTarget

        check isOnRedstone do
            check isSneaking do

                make currentTarget = 100
            end
        end

        make progress = pistonTop.smooth(progress, currentTarget, 0.45)
        pistonTop.translate(0, 0.25 * (progress / 100), 0)
    end

    check itemRendered.getName() == "minecraft:sticky_piston" do
        itemRendered.setItemModel("interactivestuff:piston_base")

        make pistonTop = new ItemModel("minecraft:sticky_piston")
        pistonTop.setItemModel("interactivestuff:sticky_piston_top")


        make currentStTarget = fallTarget


        check isOnRedstone do
            check isSneaking do
                make currentStTarget = 100
            end
        end


        make stprogress = pistonTop.smooth(stprogress, currentStTarget, 0.45)

        pistonTop.translate(0, 0.275 * (stprogress / 100), 0)
    end

end