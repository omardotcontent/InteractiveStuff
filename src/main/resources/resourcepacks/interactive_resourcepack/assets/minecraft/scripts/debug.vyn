task onTick do
    debugText("§6Game version: " + modLoader.getRawGameVersion())
    debugText("§cHealth: " + player.getHealth())
    debugText("§aStepping Block: " + player.getSteppingBlock().getName())
    check player.getTargetBlock() != nothing do
        debugText("§aTarget Block: " + player.getTargetBlock().getName())
    end
    debugText("§2Gamemode: " + player.getGameMode())
    debugText("§6Pos: " + player.getPosition().getX() + ", " + player.getPosition().getY() + ", " + player.getPosition().getZ())
    debugText("§bDimension: " + player.getWorld().getDimension())
    debugText("§eIs Sneaking?: " + player.isSneaking())
    debugText("§eIs Swimming?: " + player.isSwimming())
    debugText("§eIs Sprinting?: " + player.isSprinting())
    debugText("§eOn Ground?: " + player.isOnGround())
    debugText("§eIs Jumping?: " + player.isJumping())
    debugText("§eIs Underwater?: " + player.isSubmergedInWater())
    debugText("§eIs at cloud height?: " + player.isAtCloudHeight())
    debugText("§bX Velocity: " + player.getVelocityX())
    debugText("§bY Velocity: " + player.getVelocityY())
    debugText("§bZ Velocity: " + player.getVelocityZ())
    debugText("§bCamera Pitch: " + isp.getCameraPitchVelocity())
    debugText("§bCamera Yaw: " + isp.getCameraYawVelocity())
end