lock interactiveItems = ["minecraft:sculk_sensor", "minecraft:calibrated_sculk_sensor"]

make sculkParticles = new ParticleEmitter("minecraft:sculk_charge_pop")
sculkParticles.setPosition(0.5, 0.78, 0.5)
sculkParticles.setSpread(0.28, 0.06, 0.28)
sculkParticles.setLifetime(16)
sculkParticles.setVelocity(0, 0.01, 0)
sculkParticles.setVelocitySpread(0.012, 0.004, 0.012)
sculkParticles.setSizeOverLife(0.025, 0.065, "easeOutCubic")
sculkParticles.setOpacityOverLife(0.9, 0, "easeInQuad")
sculkParticles.setLight(15)
sculkParticles.setAttached(true)

make wasOnGround = false
make intensity = 0.0

make vibrating = false
make calibratedVibrating = false

lock RANGE_NORMAL = 8
lock RANGE_CALIBRATED = 16

lock COOLDOWN_NORMAL = 40
lock COOLDOWN_CALIBRATED = 20
lock IGNORED_SOUND_IDS = new List
IGNORED_SOUND_IDS.add("minecraft:block.sculk_sensor.clicking", "minecraft:block.sculk_sensor.clicking_stop", "minecraft:block.wool.fall", "minecraft:block.wool.break", "minecraft:block.wool.place", "minecraft:block.wool.step", "minecraft:block.wool.hit")

task onTick do
    check config.isSculkSensorFeatureEnabled() && player.isFirstPerson() do
        make isOnGround = player.isOnGround()
        check !wasOnGround && isOnGround do
            handleLanding()
        end
        make wasOnGround = isOnGround
    end
end

task handleLanding do
    check !player.getSteppingBlock().hasBlockTag("wool") && !player.isSneaking() do
        check player.getGamemode() != "spectator" do
            processVibration(player.getPosition())
        end
    end
end

task onPlaySound takes sound do
    check config.isSculkSensorFeatureEnabled() && player.isFirstPerson() do
        check !IGNORED_SOUND_IDS.contains(sound.getName()) do
            processVibration(sound.getPosition())
        end
    end
end

task processVibration takes position do
    make distance = player.getPosition().getDistanceTo(position)

    check player.isHoldingItem("minecraft:calibrated_sculk_sensor") do
        handleCalibratedSensor(distance)
    end

    check player.isHoldingItem("minecraft:sculk_sensor") do
        handleSensor(distance)
    end
end


task handleSensor takes distance do
    check !vibrating do
        check distance <= RANGE_NORMAL do
            make vibrating = true
            sculkParticles.burst(6)
            player.playSound("minecraft:block.sculk_sensor.clicking", 1.0, 1.0)
            pulse()
            wait COOLDOWN_NORMAL do
                make vibrating = false
                check player.isHoldingItem("minecraft:sculk_sensor") && player.isFirstPerson() do
                    player.playSound("minecraft:block.sculk_sensor.clicking_stop", 1.0, 1.0)
                end
            end
        end
    end
end

task handleCalibratedSensor takes distance do
    check !calibratedVibrating do
        check distance <= RANGE_CALIBRATED do
            make calibratedVibrating = true
            sculkParticles.burst(6)
            player.playSound("minecraft:block.sculk_sensor.clicking", 1.0, 1.0)
            pulse()
            wait COOLDOWN_CALIBRATED do
                make calibratedVibrating = false
                check player.isHoldingItem("minecraft:calibrated_sculk_sensor") && player.isFirstPerson() do
                    player.playSound("minecraft:block.sculk_sensor.clicking_stop", 1.0, 1.0)
                end
            end
        end
    end
end

task onItemUpdate takes itemRendered do
    check !config.isSculkSensorFeatureEnabled() || player.getGamemode() == "spectator" do
        reply nothing
    end
    sculkParticles.setRate(0)
    check vibrating && itemRendered.getName() == "minecraft:sculk_sensor" do
        sculkParticles.setRate(0.3)
    end
    check calibratedVibrating && itemRendered.getName() == "minecraft:calibrated_sculk_sensor" do
        sculkParticles.setRate(0.3)
    end
    sculkParticles.attach(itemRendered)
	check itemRendered.getName() == "minecraft:sculk_sensor" || itemRendered.getName() == "minecraft:calibrated_sculk_sensor" do
		check vibrating && itemRendered.getName() == "minecraft:sculk_sensor" do
			itemRendered.setItemModel("interactivestuff:sculk_sensor_active")
			itemRendered.translate(((random() - 0.5) * intensity), ((random() - 0.5) * intensity), 0)
			itemRendered.setLight(15)
		end

		check calibratedVibrating && itemRendered.getName() == "minecraft:calibrated_sculk_sensor" do
			itemRendered.setItemModel("interactivestuff:calibrated_sculk_sensor_active")
			itemRendered.translate(((random() - 0.5) * intensity), ((random() - 0.5) * intensity), 0)
			itemRendered.setLight(15)
		end
	end
end

task pulse do
    make intensity = 0.02
    wait 5 do
        make intensity = 0.0
    end
end