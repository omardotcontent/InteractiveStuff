lock interactiveItems = ["minecraft:enchanting_table"]

make openingProgress = 0

make glyphParticles = new ParticleEmitter("minecraft:enchant")
glyphParticles.setSpace("world")
glyphParticles.setPosition(0.5, 1.25, 0.5)
glyphParticles.setSpread(0.28, 0.15, 0.28)
glyphParticles.setLifetime(45)
glyphParticles.setVelocity(0, 0.004, 0)
glyphParticles.setVelocitySpread(0.004, 0.002, 0.004)
glyphParticles.setSizeOverLife(0.055, 0.085, "easeOutSine")
glyphParticles.setOpacityOverLife(0, 0, "linear")
glyphParticles.addOpacityKeyframe(0.15, 0.85, "easeOutQuad")
glyphParticles.addOpacityKeyframe(0.7, 0.7, "linear")
glyphParticles.setColor(200, 170, 255)
glyphParticles.setAnimation("random", 1)
glyphParticles.setLight(15)


task onItemUpdate takes itemRendered do

    check itemRendered.getName() != "minecraft:enchanting_table" do
        reply nothing
    otherwise
		check modLoader.isModLoaded("punchy") do
			itemRendered.translate(0,0.2,0)
			itemRendered.scale(0.8,0.8,0.8)
		end
	end

    make bookshelfNearby = player.hasNearbyBlock("minecraft:bookshelf", 2)

    make progress = 0
    check bookshelfNearby do
        make progress = 100
    end

    make openingProgress = itemRendered.smooth(openingProgress, progress, 0.2)
    glyphParticles.setRate(0.2 + (openingProgress / 100) * 0.3)
    glyphParticles.attach(itemRendered)
    make book_left = new ItemModel("minecraft:book")
    make book_right = new ItemModel("minecraft:book")
	book_left.setParent(itemRendered)
	book_right.setParent(itemRendered)

    book_right.setPivot(0, 0.13, 0)
    book_left.setPivot(0.0, 0.13, 0.0)
    book_right.rotate(0, 0, -60 * (openingProgress / 100))
    book_left.rotate(0, 0, 60 * (openingProgress / 100))
    book_left.setItemModel("interactivestuff:book_left")
    book_right.setItemModel("interactivestuff:book_right")
end
