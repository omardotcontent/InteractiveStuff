importScript("interactivestuff:interactive_resourcepack", "effect_helpers")

make shakeOption = packShakeOption()

make effectOption = packToggle("torch_extinguish", "animation")
effectOption.setOnChange("onTorchOptionChanged")

lock interactiveItems = ["minecraft:campfire", "minecraft:torch", "minecraft:redstone_torch", "minecraft:soul_campfire", "minecraft:soul_torch", "minecraft:wall_torch", "minecraft:copper_torch"]

lock HOT_ITEMS = new List
HOT_ITEMS.add("minecraft:campfire", "minecraft:torch", "minecraft:redstone_torch", "minecraft:soul_campfire", "minecraft:soul_torch", "minecraft:wall_torch", "minecraft:copper_torch")

make wasSubmerged = false
make intensity = 0.0

task onTorchOptionChanged takes option, previous, value do
    make wasSubmerged = nothing
    make intensity = 0
end

task onTick do
    check !effectOption.getBoolean() do reply nothing end
    make isSubmerged = player.isSubmergedInWater()
    check player.getGamemode() != "spectator" && player.isFirstPerson() && wasSubmerged != nothing && wasSubmerged != isSubmerged do
        check isPlayerHoldingAnyHotItem() do
            check isSubmerged do
                player.playSound("minecraft:block.fire.extinguish", 0.6, 1.0)
                make intensity = 0.015
            otherwise
                player.playSound("minecraft:item.flintandsteel.use", 0.6, 1.0)
            end
        end
    end
    make wasSubmerged = isSubmerged
    make intensity = max(0, intensity - 0.001)
end

task onItemUpdate takes itemRendered do
    check effectOption.getBoolean() && player.getGamemode() != "spectator" do
        check player.isSubmergedInWater() do
            make isTheItem = false
            check isWaterTorch(itemRendered) && itemRendered.getName() != "minecraft:redstone_torch" do
                itemRendered.setItemModel("interactivestuff:torch_off")
                make isTheItem = true
            end
            check itemRendered.getName() == "minecraft:redstone_torch" do
                itemRendered.setItemModel("interactivestuff:redstone_torch_off")
                make isTheItem = true
            end
            check isWaterCampFire(itemRendered) do
                itemRendered.setItemModel("interactivestuff:campfire_off")
                make isTheItem = true
            end
            check isTheItem do
                itemRendered.translate(((random() - 0.5) * intensity * shakeOption.getNumber() / 100), ((random() - 0.5) * intensity * shakeOption.getNumber() / 100), 0)
            end
        otherwise
            check isHoldingHotItem(itemRendered) do
                check itemRendered.getName() != "minecraft:redstone_torch" || !isRedstonePowered() do
                    itemRendered.setLight(15)
                end
            end
        end
    end
end


task isHoldingHotItem takes itemRendered do
    reply HOT_ITEMS.contains(itemRendered.getName())
end


task isPlayerHoldingAnyHotItem do
    reply HOT_ITEMS.contains(player.getMainHandItem().getName()) || HOT_ITEMS.contains(player.getOffHandItem().getName())
end

task isWaterTorch takes itemHeld do
    make id = itemHeld.getName()
    reply id == "minecraft:torch" || id == "minecraft:redstone_torch" || id == "minecraft:soul_torch" || id == "minecraft:copper_torch"
end

task isWaterCampFire takes itemHeld do
    make id = itemHeld.getName()
    reply id == "minecraft:campfire" || id == "minecraft:soul_campfire"
end
