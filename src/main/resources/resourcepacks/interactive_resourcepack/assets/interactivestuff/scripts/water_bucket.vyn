importScript("interactivestuff:interactive_resourcepack", "effect_helpers")

make effectOption = packToggle("tint_water", "appearance")
make animationOption = packToggle("animate_water_bucket", "animation")

lock interactiveItems = ["minecraft:water_bucket"]

task onItemUpdate takes itemRendered do
    check !effectOption.getBoolean() && !animationOption.getBoolean() do reply nothing end
    check player.getGamemode() == "spectator" || itemRendered.getName() != "minecraft:water_bucket" do reply nothing end
    check animationOption.getBoolean() && player.isSubmergedInWater() do
        itemRendered.setItemModel("minecraft:bucket")
        reply nothing
    end
    check !effectOption.getBoolean() do reply nothing end
    itemRendered.setItemModel("interactivestuff:bucket")
    make waterOfBucket = new ItemModel("minecraft:bucket")

    waterOfBucket.setItemModel("interactivestuff:water_of_the_bucket")
    waterOfBucket.setTint(0, player.getWorld().getWaterColor(player.getSteppingBlock().getPosition()))
end
