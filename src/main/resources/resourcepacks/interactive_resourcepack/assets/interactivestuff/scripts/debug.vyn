make debugModeOption = new ConfigOption("debug_mode", "toggle", false)
debugModeOption.setLabel("interactive_stuff.config.menu.setting.debug")
debugModeOption.setCategory("interactive_stuff.config.menu.pack.category.debug")
debugModeOption.setTooltip("interactive_stuff.config.menu.setting.debug.tooltip")

make debugCounterOption = new ConfigOption("debug_counters", "toggle", false)
debugCounterOption.setLabel("interactive_stuff.config.menu.setting.counter")
debugCounterOption.setCategory("interactive_stuff.config.menu.pack.category.debug")
debugCounterOption.setTooltip("interactive_stuff.config.menu.setting.counter.tooltip")

task onTick do
    check !debugModeOption.getBoolean() do
        showParticleCounters()
        reply nothing
    end
    debugText("§6Game version: " + modLoader.getRawGameVersion())
    debugText("§aMain Hand Item: " + player.getMainHandItem().getName())
    check player.getBlockingItem() != nothing do
        debugText("§aBlocking Item: " + player.getBlockingItem().getName())
    end
    check player.getWeaponItem() != nothing do
        debugText("§aWeapon Item: " + player.getWeaponItem().getName())
    end
    check player.getPickBlockItem() != nothing do
        debugText("§aPick Block Item: " + player.getPickBlockItem().getName())
    end
    debugText("§cHealth: " + player.getHealth())
    debugText("§aStepping Block: " + player.getSteppingBlock().getName())
    check player.getTargetBlock() != nothing do
        debugText("§aTarget Block: " + player.getTargetBlock().getName())
    end
    debugText("§2Gamemode: " + player.getGamemode())
    debugText("§6Pos: " + player.getPosition().getX() + ", " + player.getPosition().getY() + ", " + player.getPosition().getZ())
    debugText("§bDimension: " + player.getWorld().getDimension())
    debugText("§eIs 1st Person?: " + player.isFirstPerson())
    debugText("§eIs Sneaking?: " + player.isSneaking())
    debugText("§eIs Swimming?: " + player.isSwimming())
    debugText("§eIs Sprinting?: " + player.isSprinting())
    debugText("§eOn Ground?: " + player.isOnGround())
    debugText("§eIs Jumping?: " + player.isJumping())
    debugText("§eIs Underwater?: " + player.isSubmergedInWater())
    debugText("§eIs at cloud height?: " + player.isAtCloudHeight())
    debugText("§bX Velocity: " + player.getVelocityX())
    debugText("§bY Velocity: " + player.getVelocityY())
    debugText("§bZ Velocity: " + player.getVelocityZ())
    debugText("§bCamera Pitch: " + player.getCameraPitchVelocity())
    debugText("§bCamera Yaw: " + player.getCameraYawVelocity())
    showParticleCounters()
end

task showParticleCounters do
    check debugCounterOption.getBoolean() do
        debugText(translateText("interactivestuff.debug.particles", particles.getCount(), config.getParticleLimit(), particles.getEmitterCount(), particles.getDroppedCount()), true)
    end
end
