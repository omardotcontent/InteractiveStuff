task onTick do
    check player.getSteppingBlock() != nothing do
        debugText("Stepping Block: " + player.getSteppingBlock().getName())
    end
    debugText("Target Block: " + player.getTargetBlock().getName())
    debugText("Gamemode: " + player.getGamemode())
    debugText("Pos: " + player.getPosition().getX() + ", " + player.getPosition().getY() + ", " + player.getPosition().getZ())
    debugText("Dimension: " + player.getWorld().getDimension())
    debugText("Is Sneaking?: " + player.isSneaking())
    debugText("Is Swimming?: " + player.isSwimming())
    debugText("Is Sprinting?: " + player.isSprinting())
    debugText("On Ground?: " + player.isOnGround())
    debugText("Is Jumping?: " + player.isJumping())
    debugText("Is Underwater?: " + player.isSubmergedInWater())
    debugText("Is at cloud height?: " + player.isAtCloudHeight())
    debugText("X Velocity: " + player.getVelocityX())
    debugText("Y Velocity: " + player.getVelocityY())
    debugText("Z Velocity: " + player.getVelocityZ())
end