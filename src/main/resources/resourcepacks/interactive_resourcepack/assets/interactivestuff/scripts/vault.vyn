importScript("interactivestuff:interactive_resourcepack", "effect_helpers")

make effectOption = packToggle("animate_vault", "animation")

lock interactiveItems = ["minecraft:vault"]

lock lootItems = new List
lootItems.add("minecraft:wind_charge","minecraft:emerald","minecraft:iron_ingot","minecraft:diamond","minecraft:ominous_bottle","minecraft:honey_bottle","minecraft:golden_apple","minecraft:golden_carrot","minecraft:enchanted_book")

lock cooldown = 2000
make lastChangeTime = 0
make currentLootItem = nothing

task getRandomItem do
    reply lootItems.get(random(0, lootItems.size() - 1))
end

task onItemUpdate takes itemRendered do
    check effectOption.getBoolean() && player.getGamemode() != "spectator" do
        check itemRendered.getName() == "minecraft:vault" do
			check hasMod("punchy") do
				itemRendered.translate(0,0,0)
			otherwise
				itemRendered.translate(0, 0.2, 0)
			end

            make now = time()

            check currentLootItem == nothing do
                make currentLootItem = getRandomItem()
                make lastChangeTime = now
            end

            check (now - lastChangeTime) >= cooldown do
                make currentLootItem = getRandomItem()
                make lastChangeTime = now
            end

            make lootModel = new ItemModel(currentLootItem)
            check itemRendered.isRightHand() do
                lootModel.setPivot(0.02, 0.05, 0.02)
                lootModel.translate(-0.05, 0.15, 0)
            otherwise
                lootModel.setPivot(-0.02, 0.05, 0.02)
                lootModel.translate(0.05, 0.15, 0)
            end

			check hasMod("punchy") do
				lootModel.translate(0, -0.22, 0)
			end
            lootModel.scale(0.3, 0.3, 0.3)
            lootModel.rotateAxis((now * 0.25) % 360, 0, 1, 0)
            lootModel.rotateX(25)
        end
    end
end
