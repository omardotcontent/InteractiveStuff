task onItemUpdate takes itemRendered do
    check config.isTextureChangesEnabled() && player.getGamemode() != "spectator" do
        check isHoldingMySapling() do
            check isItemSapling(itemRendered) do
                itemRendered.setItemModel("interactivestuff:" + itemRendered.getName() + "_wood")

                make saplingLeaves = new ItemModel("minecraft:oak_sapling")
                saplingLeaves.setItemModel("interactivestuff:" + itemRendered.getName() + "_leaves")

                saplingLeaves.setTint(player.getWorld().getFoliageColor(player.getSteppingBlock().getPosition()))
            end
        end
    end
end


task isHoldingMySapling do
    reply player.isHoldingItem("minecraft:oak_sapling") || player.isHoldingItem("minecraft:spruce_sapling") || player.isHoldingItem("minecraft:jungle_sapling") || player.isHoldingItem("minecraft:acacia_sapling") || player.isHoldingItem("minecraft:dark_oak_sapling")
end


task isItemSapling takes item do
    reply item.getName() == "minecraft:oak_sapling" || item.getName() == "minecraft:spruce_sapling" || item.getName() == "minecraft:jungle_sapling" || item.getName() == "minecraft:acacia_sapling" || item.getName() == "minecraft:dark_oak_sapling"
end