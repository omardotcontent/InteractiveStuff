make wasSubmerged = false
make intensity = 0.0

task onTick do
    check config.isTextureChangesEnabled() && player.getGamemode() != "spectator" do
        make isSubmerged player.isSubmergedInWater()
        check wasSubmerged != isSubmerged do
            make wasSubmerged = isSubmerged
            check isHoldingCampfireOrTorch() do
                check isSubmerged do
                    player.playSound("minecraft:block.fire.extinguish", 0.6, 1.0)
                    make intensity = 0.015
                otherwise
                    player.playSound("minecraft:item.flintandsteel.use", 0.6, 1.0)
                end
            end
        end
        check intensity > 0.0 do
                make intensity = intensity - 0.001
                check intensity < 0.0 do
                    make intensity = 0.0
                end
        end
    end
end


task onItemUpdate takes itemRendered do
    check config.isTextureChangesEnabled() && player.getGamemode() != "spectator" do
        check player.isSubmergedInWater() do
            make isTheItem = false
            check isWaterTorch(itemRendered) do
                itemRendered.setDataComponent("minecraft:item_model", "interactivestuff:torch_off")
                make isTheItem = true
            end
            check isRedStoneTorch(itemRendered) do
                itemRendered.setDataComponent("minecraft:item_model", "interactivestuff:redstone_torch_off")
                make isTheItem = true
            end
            check isWaterCampFire(itemRendered) do
                itemRendered.setDataComponent("minecraft:item_model", "interactivestuff:campfire_off")
                make isTheItem = true
            end
            check isTheItem do
                itemRendered.translate(((random() - 0.5) * intensity), ((random() - 0.5) * intensity), 0)
            end
        end
    end
end


task isHoldingCampfireOrTorch do
    reply player.isHoldingItem("minecraft:campfire") || player.isHoldingItem("minecraft:torch") || player.isHoldingItem("minecraft:redstone_torch") || player.isHoldingItem("minecraft:soul_campfire") || player.isHoldingItem("minecraft:soul_torch") || player.isHoldingItem("minecraft:wall_torch") || player.isHoldingItem("minecraft:copper_torch")
end

task isWaterTorch takes itemHeld do
    reply itemHeld.getName() == "minecraft:torch" || itemHeld.getName() == "minecraft:redstone_torch" || itemHeld.getName() == "minecraft:soul_torch" || itemHeld.getName() == "minecraft:copper_torch"
end

task isRedStoneTorch takes itemHeld do
    reply itemHeld.getName() == "minecraft:redstone_torch"
end

task isWaterCampFire takes itemHeld do
    reply itemHeld.getName() == "minecraft:campfire" || itemHeld.getName() == "minecraft:soul_campfire"
end