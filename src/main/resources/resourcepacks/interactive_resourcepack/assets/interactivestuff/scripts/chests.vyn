importScript("interactivestuff:interactive_resourcepack", "effect_helpers")

make animationOption = packToggle("animate_chests", "animation")
animationOption.setOnChange("onAnimationChanged")

lock interactiveItems = ["minecraft:chest", "minecraft:ender_chest", "minecraft:trapped_chest", "minecraft:copper_chest", "minecraft:waxed_copper_chest", "minecraft:exposed_copper_chest", "minecraft:waxed_exposed_copper_chest", "minecraft:weathered_copper_chest", "minecraft:waxed_weathered_copper_chest", "minecraft:oxidized_copper_chest", "minecraft:waxed_oxidized_copper_chest"]

lock chestVariants = new Map
chestVariants.put("minecraft:chest", "chest")
chestVariants.put("minecraft:ender_chest", "ender_chest")
chestVariants.put("minecraft:trapped_chest", "trapped_chest")
chestVariants.put("minecraft:copper_chest", "copper_chest")
chestVariants.put("minecraft:waxed_copper_chest", "copper_chest")
chestVariants.put("minecraft:exposed_copper_chest", "exposed_copper_chest")
chestVariants.put("minecraft:waxed_exposed_copper_chest", "exposed_copper_chest")
chestVariants.put("minecraft:weathered_copper_chest", "weathered_copper_chest")
chestVariants.put("minecraft:waxed_weathered_copper_chest", "weathered_copper_chest")
chestVariants.put("minecraft:oxidized_copper_chest", "oxidized_copper_chest")
chestVariants.put("minecraft:waxed_oxidized_copper_chest", "oxidized_copper_chest")

make openingState = createProgressState()

task onAnimationChanged takes option, previous, value do
    make openingState = createProgressState()
end

task onItemUpdate takes itemRendered do
    check !animationOption.getBoolean() do reply nothing end
    make variant = chestVariants.get(itemRendered.getName())
    check variant == nothing do reply nothing end

    itemRendered.setItemModel("interactivestuff:" + variant + "_base")
    make chestTop = new ItemModel("minecraft:" + variant)
    chestTop.setItemModel("interactivestuff:" + variant + "_top")
    chestTop.setParent(itemRendered)
    make openProgress = smoothItemProgress(openingState, itemRendered, getFallTarget(), 0.2)

    check itemRendered.isRightHand() do
        chestTop.setPivot(0.12, 0.17, -0.063)
        chestTop.rotateAxis(-90 * (openProgress / 100), 1, 0, 1.25)
    otherwise
        chestTop.setPivot(-0.12, 0.17, -0.063)
        chestTop.rotateAxis(-90 * (openProgress / 100), 1, 0, -1.25)
    end
end

task getFallTarget do
    reply max(-7, min(100, player.getVelocityY() * -100))
end
