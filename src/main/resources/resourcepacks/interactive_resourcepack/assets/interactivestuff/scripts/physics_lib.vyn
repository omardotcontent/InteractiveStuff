make angleX = 0
make angleZ = 0
make velX = 0
make velZ = 0
make prevCamPitch = 0
make prevCamYaw = 0
make prevMoveX = 0
make prevMoveY = 0
make prevMoveZ = 0
make isFirstFrame = 1
make lastUpdateTime = -1

task runPhysicsEngine takes stiffness, damping, moveRes, lookRes, vertRes, inertial, maxAngle, windMult do
    make now = time()

    check lastUpdateTime == now do
        reply 0
    end

    make lastUpdateTime = now

    make dt = getDelta()

    check dt > 5.0 do
            make velX = 0
            make velZ = 0
            make isFirstFrame = 1
            reply 0
    end

    check dt > 3.0 do
        make dt = 3.0
    end

    make currCamPitch = player.getCameraPitch()
    make currCamYaw = player.getCameraYaw()
    make currMoveX = -player.getVelocityX()
    make currMoveY = player.getVelocityY()
    make currMoveZ = -player.getVelocityZ()

    check isFirstFrame == 1 do
        make prevCamPitch = currCamPitch
        make prevCamYaw = currCamYaw
        make prevMoveX = currMoveX
        make prevMoveY = currMoveY
        make prevMoveZ = currMoveZ
        make isFirstFrame = 0
    end

    make dYaw = currCamYaw - prevCamYaw
    check dYaw > 180 do make dYaw = dYaw - 360 end
    check dYaw < -180 do make dYaw = dYaw + 360 end
    make dPitch = currCamPitch - prevCamPitch

    make accX = (currMoveX - prevMoveX) * moveRes
    make accZ = (currMoveZ - prevMoveZ) * moveRes
    make accY = (currMoveY - prevMoveY) * vertRes

    make windPhase = now * 0.0015
    make windVal = sin(windPhase)

    make gustPhase = now * 0.004
    make gustVal = sin(gustPhase)

    make envPhase = now * 0.0008
    make envVal = sin(envPhase) * 0.5 + 0.5
    make envVal = envVal * envVal

    make windX = (windVal * 0.02 + gustVal * 0.04 * envVal) * windMult / 100
    make windZ = (windVal * 0.02 * 0.6 - gustVal * 0.04 * envVal * 0.4) * windMult / 100

    make windForceX = (windX * 100) * inertial
    make windForceZ = (windZ * 100) * inertial

    make impulseX = ((dPitch * lookRes) + (accZ * 10.0) + (accY * 5.0)) * inertial
    make impulseZ = ((dYaw * lookRes) + (accX * 10.0)) * inertial

    make springDampX = (0 - angleX * stiffness) - (velX * damping)
    make springDampZ = (0 - angleZ * stiffness) - (velZ * damping)

    make velX = velX + (springDampX + windForceX) * dt + impulseX
    make velZ = velZ + (springDampZ + windForceZ) * dt + impulseZ
    make angleX = angleX + velX * dt
    make angleZ = angleZ + velZ * dt

    check angleX > maxAngle do make angleX = maxAngle make velX = velX * -0.5 end
    check angleX < -maxAngle do make angleX = -maxAngle make velX = velX * -0.5 end
    check angleZ > maxAngle do make angleZ = maxAngle make velZ = velZ * -0.5 end
    check angleZ < -maxAngle do make angleZ = -maxAngle make velZ = velZ * -0.5 end

    make prevCamPitch = currCamPitch
    make prevCamYaw = currCamYaw
    make prevMoveX = currMoveX
    make prevMoveY = currMoveY
    make prevMoveZ = currMoveZ
end