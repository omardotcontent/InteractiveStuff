task onItemUpdate takes itemRendered do
    check itemRendered.getName() == "minecraft:redstone_lamp" do
        check player.getSteppingBlock().getName() == "minecraft:redstone_block" do
            check player.isSneaking() do
                itemRendered.setDataComponent("minecraft:item_model", "interactivestuff:redstone_lamp_on")
            end
        end
    end
    check itemRendered.getName() == "minecraft:redstone_torch" do
        check player.getSteppingBlock().getName() == "minecraft:redstone_block" do
            check player.isSneaking() do
                itemRendered.setDataComponent("minecraft:item_model", "interactivestuff:redstone_torch_off")
            end
        end
    end
end