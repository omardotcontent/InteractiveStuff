importScript("interactivestuff:interactive_resourcepack","physics_lib")

task onItemUpdate takes itemRendered do
    check player.getGamemode() != "spectator" && isFrame(itemRendered) do
        check !modLoader.isModLoaded("holdmyitems") do
            runPhysicsEngine(0.01, 0.1, 0.6, 0.3, 0.2, 0.8, 60, 0)
            itemRendered.setPivot(0, 0.4, 0)
            itemRendered.rotate(angleX, 0, -angleZ)

            check itemRendered.isMainHand() do
                itemRendered.rotateY(65)
                itemRendered.rotateX(25)
            otherwise
                itemRendered.rotateY(-65)
                itemRendered.rotateX(25)
            end
        end
    end
end

task isFrame takes item do
    reply item.getName() == "minecraft:item_frame" || item.getName() == "minecraft:painting" || item.getName() == "minecraft:glow_item_frame" || item.getName() == "minecraft:oak_hanging_sign" || item.getName() == "minecraft:spruce_hanging_sign" || item.getName() == "minecraft:birch_hanging_sign" || item.getName() == "minecraft:jungle_hanging_sign" || item.getName() == "minecraft:acacia_hanging_sign" || item.getName() == "minecraft:dark_oak_hanging_sign" || item.getName() == "minecraft:crimson_hanging_sign" || item.getName() == "minecraft:warped_hanging_sign" || item.getName() == "minecraft:cherry_hanging_sign" || item.getName() == "minecraft:mangrove_hanging_sign" || item.getName() == "minecraft:pale_oak_hanging_sign" || item.getName() == "minecraft:bamboo_hanging_sign"
end