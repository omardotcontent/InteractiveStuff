importScript("interactivestuff:interactive_resourcepack", "effect_helpers")

make shakeOption = packShakeOption()

lock interactiveItems = ["minecraft:totem_of_undying"]


task onItemUpdate takes itemRendered do
    check player.getGamemode() != "spectator" && itemRendered.getName() == "minecraft:totem_of_undying" do
        make intensity = max(0, (20 - player.getHealth()) / 10)
        itemRendered.translate(((random() - 0.5) * intensity / 250 * shakeOption.getNumber() / 100), ((random() - 0.5) * intensity / 250 * shakeOption.getNumber() / 100), 0)
        itemRendered.rotateAxis(((random() - 0.5) * intensity / 250 * shakeOption.getNumber() / 100), 1,1,1)
    end
end
