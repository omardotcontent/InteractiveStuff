make wasSneaking = false
make pitch = 0.5

task onTick do
    check player.getWorld() == nothing do
        reply nothing
    end
    check config.isNoteBlockCrouchFeatureEnabled() && player.getGamemode() != "spectator" do
        make isSneaking = player.isSneaking()
        check player.getSteppingBlock().getName() == "minecraft:redstone_block" && player.isHoldingItem("minecraft:note_block") && isSneaking && !wasSneaking do
            player.playSound("minecraft:block.note_block.harp", 0.5, pitch)
            make pitch = max((pitch + 0.1) % 2.0, 0.5)
        end
        make wasSneaking = isSneaking
    end
end

task onSwingHand do
    check config.isSpecializedNoteblockHitsEnabled() do
        check player.getGamemode() != "spectator" && player.getGamemode() != "adventure" && player.isHoldingItem("minecraft:note_block") && player.getTargetBlock().getName() != "minecraft:air" do
            make targetBlock = player.getTargetBlock()
            player.playSoundWorld(targetBlock.getPosition(), targetBlock.getInstrument(), 0.2, 1.0)
        end
    end
end